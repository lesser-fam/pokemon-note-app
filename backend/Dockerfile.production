FROM composer:2.8 AS vendor

WORKDIR /var/www/html

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --prefer-dist \
    --optimize-autoloader \
    --no-interaction \
    --no-progress \
    --no-scripts

FROM php:8.4-apache AS production

WORKDIR /var/www/html

RUN apt-get update \
    && apt-get install -y --no-install-recommends libonig-dev libxml2-dev \
    && docker-php-ext-install -j"$(nproc)" mbstring pdo_mysql xml \
    && a2enmod rewrite \
    && rm -rf /var/lib/apt/lists/*

COPY --from=vendor /var/www/html/vendor ./vendor
COPY . .
COPY docker/production/apache-vhost.conf /etc/apache2/sites-available/000-default.conf.template
COPY docker/production/apache-ports.conf /etc/apache2/ports.conf.template
COPY docker/production/entrypoint.sh /usr/local/bin/production-entrypoint

RUN chmod +x /usr/local/bin/production-entrypoint \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

ENTRYPOINT ["production-entrypoint"]
CMD ["apache2-foreground"]
